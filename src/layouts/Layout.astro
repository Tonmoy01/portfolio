---
import '../styles/globals.css';
import {
  siteConfig,
  SITE_URL,
  structuredData,
} from '@/config/seo';
import {
  buildTitle,
  buildCanonicalUrl,
  buildRobotsDirectives,
} from 'react-ssr-seo-toolkit';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image = '/og-image.png',
  noindex = false,
} = Astro.props;

const canonicalURL = buildCanonicalUrl(SITE_URL, Astro.url.pathname);
const pageTitle = title ? title : (siteConfig.title || 'Md. Tonmoy Khan | Frontend Developer');
const ogImageUrl = image.startsWith('http') ? image : `${SITE_URL}${image.startsWith('/') ? '' : '/'}${image}`;
const robotsContent = noindex ? 'noindex, nofollow' : buildRobotsDirectives(siteConfig.robots);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Frontend Developer, React Developer, Next.js, TypeScript, Tailwind CSS, Web Developer, Md. Tonmoy Khan" />
    <meta name="author" content="Md. Tonmoy Khan" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={siteConfig.openGraph?.type || 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteConfig.openGraph?.siteName || 'Md. Tonmoy Khan | Portfolio'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content={siteConfig.twitter?.card || 'summary_large_image'} />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Robots -->
    <meta name="robots" content={robotsContent} />

    <!-- JSON-LD Structured Data (Schema.org Person & WebSite via react-ssr-seo-toolkit) -->
    <script type="application/ld+json" set:html={structuredData} />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon.svg" />

    <!-- Google Fonts: Inter & Pacifico -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Pacifico&display=swap"
      rel="stylesheet"
    />

    <!-- Early Theme Script to prevent flash -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || (!storedTheme && systemDark) || (storedTheme === 'system' && systemDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="font-sans text-page-text bg-page-bg antialiased selection:bg-selection-bg selection:text-selection-text bg-grid">
    <slot />
  </body>
</html>
